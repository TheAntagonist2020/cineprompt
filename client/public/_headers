# Cloudflare Pages cache rules.
# Vite content-hashes everything under /assets, so those files can be cached
# forever; a rebuild that changes them also changes their filenames.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# data.json is regenerated up to twice a day by CI — always revalidate, but
# let the ETag turn unchanged fetches into cheap 304s.
/data.json
  Cache-Control: public, max-age=0, must-revalidate
