# Copy to datagen/.env and fill in your own values. Never commit the real .env.

# TMDB — https://www.themoviedb.org/settings/api  (v3 API key)
TMDB_API_KEY=

# Trakt — https://trakt.tv/oauth/applications  (create an app)
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=

# Your usernames
TRAKT_USER=
LETTERBOXD_USER=
