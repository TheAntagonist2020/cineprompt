# Copy to datagen/.env and fill in your own values. Never commit the real .env.

# TMDB — https://www.themoviedb.org/settings/api  (v3 API key)   [required]
TMDB_API_KEY=

# Letterboxd — your handle (the bit in letterboxd.com/<handle>/)   [required]
LETTERBOXD_USER=
# Optional: a Letterboxd export ZIP for the complete history in one go
# (Settings -> Import & Export -> Export your data)
LETTERBOXD_EXPORT=

# Trakt — https://trakt.tv/oauth/applications  (create an app)   [optional]
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
TRAKT_USER=

# MDBList — https://mdblist.com/preferences/  (API key)   [optional]
MDBLIST_API_KEY=
